/* 首页样式 */
.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f5f6f8;
}

/* 顶部品牌区 */
.hero {
  padding: 40rpx 24rpx;
  background: linear-gradient(135deg, #07c160, #10aeff);
  border-radius: 16rpx;
  color: #fff;
  margin-bottom: 24rpx;
}
.hero__title {
  font-size: 40rpx;
  font-weight: 700;
}
.hero__sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

/* 卡片通用 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.card__title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.card__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}
.card__row .label {
  font-size: 26rpx;
  color: #888;
}
.card__row .value {
  font-size: 28rpx;
  color: #333;
}
.card__row .value.muted {
  color: #bbb;
}

/* 推荐码 */
.invite-box {
  margin: 16rpx 0 24rpx;
  padding: 24rpx;
  background: #f0f9f4;
  border: 2rpx dashed #07c160;
  border-radius: 12rpx;
  text-align: center;
}
.invite-code {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #07c160;
}

/* 按钮 */
.btn {
  width: 100%;
  margin-top: 16rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  border-radius: 12rpx;
  border: none;
}
.btn--primary {
  background: #07c160;
  color: #fff;
}
.btn--ghost {
  background: #fff;
  color: #07c160;
  border: 2rpx solid #07c160;
}

/* 加载 */
.loading-box {
  padding: 80rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}
