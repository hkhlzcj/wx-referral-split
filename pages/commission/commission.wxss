/* 佣金页样式 */
.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f5f6f8;
}
.page__header {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

/* 汇总卡片 */
.summary {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.summary__item {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #f0f0f0;
}
.summary__item:last-child {
  border-right: none;
}
.summary__num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #07c160;
}
.summary__num.pending {
  color: #d48806;
}
.summary__num.danger {
  color: #f5222d;
}
.summary__label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}

/* 推荐码 */
.invite {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f0f9f4;
  border: 2rpx dashed #07c160;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}
.invite__label {
  font-size: 24rpx;
  color: #888;
}
.invite__code {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #07c160;
}

/* 加载 */
.loading-box {
  padding: 80rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

/* 流水列表 */
.list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.log-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.log-item:last-child {
  border-bottom: none;
}
.log-item__left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.log-item__goods {
  font-size: 28rpx;
  color: #333;
}
.log-item__time {
  font-size: 22rpx;
  color: #bbb;
}
.log-item__right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}
.log-item__amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #07c160;
}
.log-item__status {
  font-size: 22rpx;
}
.status--success {
  color: #07c160;
}
.status--pending {
  color: #d48806;
}
.status--failed,
.status--timeout {
  color: #f5222d;
}

/* 空态 */
.empty {
  padding: 120rpx 48rpx;
  text-align: center;
}
.empty__title {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 12rpx;
}
.empty__sub {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 32rpx;
}
.share-btn {
  display: inline-block;
  padding: 16rpx 48rpx;
  font-size: 28rpx;
  color: #fff;
  background: #07c160;
  border-radius: 40rpx;
  border: none;
}
